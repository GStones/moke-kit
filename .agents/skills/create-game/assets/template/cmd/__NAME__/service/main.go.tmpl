// Aggregate-style entry: game transports + local infra + stub auth.
// Swap dfx.AuthModule for platform AuthAllModule / AuthMiddlewareModule when ready
// (do not keep both — they both provide AuthMiddleware).
func main() {
	fxmain.Main(
		mfx.NatsModule,
		mfx.LocalModule,
		ofx.RedisCacheModule,

		// gRPC + HTTP (TCP opt-in via modules.AllWithTCPModule)
		modules.AllModule,
		dfx.AuthModule,
	)
}
