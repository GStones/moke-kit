# Game template environment (copy to .env and adjust)

APP_NAME=__NAME__
APP_ID=__NAME__
DEPLOYMENT=local
VERSION=0.0.1

# Stub AuthModule only checks bearer presence. For real ValidateToken use
# github.com/moke-game/platform AuthMiddlewareModule / AuthAllModule and set:
# AUTH_URL=localhost:8081
# JWT_TOKEN_SECRET=change-me-in-prod

TLS_ENABLE=false
MTLS_ENABLE=false
TCP_TLS_ENABLE=false
CORS_ALLOW_ORIGINS=*

NATS_URL=nats://localhost:4222
DATABASE_URL=mongodb://localhost:27017
DB_NAME=__NAME__
CACHE_URL=redis://localhost:6379

PORT=8081
GAME_URL=localhost:8081
# TCP/zinx is opt-in (TcpModule / AllWithTCPModule) and has NO gRPC auth.
# ZINX_TCP_PORT=8888
