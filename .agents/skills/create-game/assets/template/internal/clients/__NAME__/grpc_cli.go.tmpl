package __NAME__

import (
	"context"
	"errors"
	"fmt"
	"sync"

	"github.com/abiosoft/ishell"
	mm "github.com/grpc-ecosystem/go-grpc-middleware/v2/metadata"
	"github.com/gstones/moke-kit/logging/slogger"
	"google.golang.org/grpc"
	"google.golang.org/grpc/metadata"

	pb "__MODULE__/api/gen/__NAME__/api"
)

type GrpcCli struct {
	client pb.__NAME_TITLE__ServiceClient
	cmd    *ishell.Cmd

	mu    sync.RWMutex
	token string
}

func NewGrpcCli(conn *grpc.ClientConn) *GrpcCli {
	cmd := &ishell.Cmd{
		Name:    "__NAME__",
		Help:    "__NAME__ interactive",
		Aliases: []string{"g"},
	}
	p := &GrpcCli{
		client: pb.New__NAME_TITLE__ServiceClient(conn),
		cmd:    cmd,
		token:  "10000", // stub AuthModule default uid bearer
	}
	p.initSubShells()
	return p
}

func (p *GrpcCli) GetCmd() *ishell.Cmd { return p.cmd }

func (p *GrpcCli) SetAccessToken(token string) {
	p.mu.Lock()
	defer p.mu.Unlock()
	p.token = token
}

func (p *GrpcCli) accessToken() string {
	p.mu.RLock()
	defer p.mu.RUnlock()
	return p.token
}

func (p *GrpcCli) initSubShells() {
	p.cmd.AddCmd(&ishell.Cmd{
		Name:    "token",
		Help:    "set bearer token (stub AuthModule: any non-empty token becomes uid)",
		Aliases: []string{"t"},
		Func:    p.setToken,
	})
	p.cmd.AddCmd(&ishell.Cmd{Name: "hi", Help: "say hi", Aliases: []string{"hi"}, Func: p.sayHi})
	p.cmd.AddCmd(&ishell.Cmd{Name: "watch", Help: "watch topic", Aliases: []string{"w"}, Func: p.watch})
}

func (p *GrpcCli) setToken(c *ishell.Context) {
	c.ShowPrompt(false)
	defer c.ShowPrompt(true)
	tok := slogger.ReadLine(c, "access token (default stub uid bearer): ")
	if tok == "" {
		slogger.Warn(c, errors.New("empty token"))
		return
	}
	p.SetAccessToken(tok)
	slogger.Infof(c, "token set (%d chars)", len(tok))
}

func (p *GrpcCli) authCtx() (context.Context, error) {
	tok := p.accessToken()
	if tok == "" {
		return nil, errors.New("no access token; run: __NAME__ token")
	}
	md := metadata.Pairs("authorization", fmt.Sprintf("%s %s", "bearer", tok))
	return mm.MD(md).ToOutgoing(context.Background()), nil
}

func (p *GrpcCli) sayHi(c *ishell.Context) {
	c.ShowPrompt(false)
	defer c.ShowPrompt(true)
	msg := "hello"
	if in := slogger.ReadLine(c, "message(default:hello): "); in != "" {
		msg = in
	}
	topic := "__NAME__"
	if t := slogger.ReadLine(c, "topic(default:__NAME__): "); t != "" {
		topic = t
	}
	ctx, err := p.authCtx()
	if err != nil {
		slogger.Warn(c, err)
		return
	}
	resp, err := p.client.Hi(ctx, &pb.HiRequest{Message: msg, Topic: topic})
	if err != nil {
		slogger.Warn(c, err)
		return
	}
	slogger.Infof(c, "Response: %s", resp.Message)
}

func (p *GrpcCli) watch(c *ishell.Context) {
	c.ShowPrompt(false)
	defer c.ShowPrompt(true)
	topic := "__NAME__"
	if t := slogger.ReadLine(c, "topic(default:__NAME__): "); t != "" {
		topic = t
	}
	ctx, err := p.authCtx()
	if err != nil {
		slogger.Warn(c, err)
		return
	}
	stream, err := p.client.Watch(ctx, &pb.WatchRequest{Topic: topic})
	if err != nil {
		slogger.Warn(c, err)
		return
	}
	for {
		resp, err := stream.Recv()
		if err != nil {
			slogger.Warn(c, err)
			return
		}
		slogger.Infof(c, "Watch: %s", resp.Message)
	}
}
