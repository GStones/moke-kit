import {Client, StatusOK} from 'k6/net/grpc';
import {check, sleep} from 'k6';
import {makeParams} from "../common/common.js";

const client = new Client();
client.load(['./'], '__NAME__-k6.proto', 'auth-k6.proto');

// Stub AuthModule: set AUTH_TOKEN (default "10000") and leave USE_PLATFORM_AUTH unset.
// Platform AuthAllModule / AuthMiddlewareModule: set USE_PLATFORM_AUTH=1 and AUTH_HOST.
// Aggregate: AUTH_HOST can equal SERVER_HOST. Thin: AUTH_HOST must be remote AuthService.
const GRPC_ADDR = __ENV.SERVER_HOST || '127.0.0.1:8081';
const AUTH_ADDR = __ENV.AUTH_HOST || GRPC_ADDR;
const USE_PLATFORM_AUTH = __ENV.USE_PLATFORM_AUTH === '1' || __ENV.USE_PLATFORM_AUTH === 'true';
const AUTH_ID = __ENV.AUTH_ID || 'k6-user';
const APP_ID = __ENV.APP_ID || 'test';
const STUB_TOKEN = __ENV.AUTH_TOKEN || '10000';

export function setup() {
  if (!USE_PLATFORM_AUTH) {
    return {token: STUB_TOKEN};
  }
  client.connect(AUTH_ADDR, {plaintext: true});
  const authResp = client.invoke('auth.v1.AuthService/Authenticate', {
    id: AUTH_ID,
    app_id: APP_ID,
  });
  check(authResp, {
    'authenticate ok': (r) => r && r.status === StatusOK,
  });
  const token = authResp.message && (authResp.message.accessToken || authResp.message.access_token);
  client.close();
  if (!token) {
    throw new Error('Authenticate did not return access_token (check AUTH_HOST / USE_PLATFORM_AUTH)');
  }
  return {token};
}

export default function (data) {
  client.connect(GRPC_ADDR, {plaintext: true});
  const payload = {
    message: 'hello',
    topic: '__NAME__',
  };
  const params = makeParams(data.token);
  const response = client.invoke('__NAME__.pb.__NAME_TITLE__Service/Hi', payload, params);
  check(response, {
    'status is OK': (r) => r && r.status === StatusOK,
  });
  client.close();
  sleep(1);
}
