package modules

import (
	"go.uber.org/fx"

	"__MODULE__/internal/services/__NAME__"
	"__MODULE__/pkg/dfx"
)

// GrpcModule starts the game gRPC service with AuthModule.
var GrpcModule = fx.Module("grpcService",
	dfx.SettingsModule,
	dfx.AuthModule,
	__NAME__.ServiceInstance,
	__NAME__.GrpcService,
)

// HttpModule starts gRPC + grpc-gateway with AuthModule.
var HttpModule = fx.Module("httpService",
	dfx.SettingsModule,
	dfx.AuthModule,
	__NAME__.ServiceInstance,
	__NAME__.GrpcService,
	__NAME__.HttpService,
)

// TcpModule starts the zinx TCP service (no gRPC auth — trusted networks only).
var TcpModule = fx.Module("tcpService",
	dfx.SettingsModule,
	__NAME__.ServiceInstance,
	__NAME__.TcpService,
)

// AllModule starts game gRPC + HTTP gateway (TCP omitted by default).
// Auth is not included here — pair dfx.AuthModule in main, or replace with
// platform auth.AuthMiddlewareModule / auth.AuthAllModule (do not provide both).
var AllModule = fx.Module("allService",
	dfx.SettingsModule,
	__NAME__.ServiceInstance,
	__NAME__.GrpcService,
	__NAME__.HttpService,
)

// AllWithTCPModule adds unauthenticated TCP (zinx). Do not expose publicly.
// Pair auth in main the same way as AllModule.
var AllWithTCPModule = fx.Module("allServiceWithTcp",
	dfx.SettingsModule,
	__NAME__.ServiceInstance,
	__NAME__.GrpcService,
	__NAME__.HttpService,
	__NAME__.TcpService,
)

// GrpcClientModule provides an outbound gRPC client.
var GrpcClientModule = fx.Module("grpcClient",
	dfx.SettingsModule,
	dfx.__NAME_TITLE__ClientModule,
)
